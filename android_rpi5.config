# Raspberry Pi 5 options, applied by build_kernel.sh after bcm2712_defconfig
# and the AOSP android-base.config.

# The Android platform for this device is built for 4K pages.
CONFIG_ARM64_4K_PAGES=y
CONFIG_LOCALVERSION="-v8-4k"

# Drivers for hardware used from early boot. bcm2712_defconfig builds them
# as modules, and only the modules in modules.list are loaded, so they are
# built in: HDMI display, GPU, HDMI DDC (EDID), HDMI audio, touchscreens.
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_V3D=y
CONFIG_I2C_BRCMSTB=y
CONFIG_SND_SOC=y
CONFIG_HID_MULTITOUCH=y

# Built in so that options required by android-base.config can be built in:
# device mapper (DM_VERITY, DM_SNAPSHOT), socket diagnostics (INET_UDP_DIAG),
# the mirred action (IFB) and multicolor LEDs (HID_PLAYSTATION).
CONFIG_BLK_DEV_DM=y
CONFIG_INET_DIAG=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_LEDS_CLASS_MULTICOLOR=y

# bcm2712_defconfig sets an empty LSM list, which leaves SELinux disabled.
# This is the kernel's default order when SELinux is the first major LSM.
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,ipe,bpf"
