# Android options for the Raspberry Pi 5 kernel, applied on top of the Raspberry
# Pi bcm2712_defconfig by build_kernel.sh.
#
# Generated as the difference between bcm2712_defconfig and the configuration of
# the previously shipped 6.6 kernel. Most entries turn drivers that
# bcm2712_defconfig builds as modules into built-in drivers, because Android on
# this device loads no kernel modules. The rest select 4K pages, SELinux and the
# networking options Android requires.
# CONFIG_ARM64_16K_PAGES is not set
# CONFIG_DEFAULT_SECURITY_APPARMOR is not set
# CONFIG_DM_INIT is not set
# CONFIG_DRM_DEBUG_MM is not set
# CONFIG_SECURITY_SELINUX_DEBUG is not set
CONFIG_ARCH_FORCE_MAX_ORDER=10
CONFIG_ARCH_MMAP_RND_BITS_MAX=24
CONFIG_ARCH_MMAP_RND_BITS_MIN=18
CONFIG_ARCH_MMAP_RND_COMPAT_BITS_MIN=11
CONFIG_ARCH_WANTS_THP_SWAP=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_CONT_PMD_SHIFT=4
CONFIG_ARM64_CONT_PTE_SHIFT=4
CONFIG_ARM64_VA_BITS=39
CONFIG_ARM64_VA_BITS_39=y
CONFIG_BLK_DEV_DM=y
CONFIG_CEC_CORE=y
